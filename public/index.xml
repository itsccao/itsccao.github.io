			<item>
				<title>Xem ngày Âm Lịch</title>
				<link>http://localhost:1313/project/toolbox/xem-ngay-am-lich/</link>
				<pubDate>Tue, 09 Dec 2025 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/project/toolbox/xem-ngay-am-lich/</guid>
				<description>&lt;div class=&#34;amlich-wrapper&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;amlich-header-note&#34;&gt;&#xD;&#xA;        &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;16&#34; height=&#34;16&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;&#xD;&#xA;            &lt;circle cx=&#34;12&#34; cy=&#34;12&#34; r=&#34;10&#34;&gt;&lt;/circle&gt;&#xD;&#xA;            &lt;line x1=&#34;12&#34; y1=&#34;16&#34; x2=&#34;12&#34; y2=&#34;12&#34;&gt;&lt;/line&gt;&#xD;&#xA;            &lt;line x1=&#34;12&#34; y1=&#34;8&#34; x2=&#34;12.01&#34; y2=&#34;8&#34;&gt;&lt;/line&gt;&#xD;&#xA;        &lt;/svg&gt;&#xD;&#xA;        &lt;span&gt;Thuật toán tính ngày Âm Lịch bởi tác giả Hồ Ngọc Đức — &lt;a href=&#34;https://www.xemamlich.uhm.vn/calrules.html&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;Xem tài liệu thuật toán &amp;rarr;&lt;/a&gt;&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;amlich-picker-card&#34;&gt;&#xD;&#xA;        &lt;label for=&#34;am-lich-input&#34; class=&#34;amlich-label&#34;&gt;&#xD;&#xA;            &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;18&#34; height=&#34;18&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;&#xD;&#xA;                &lt;rect width=&#34;18&#34; height=&#34;18&#34; x=&#34;3&#34; y=&#34;4&#34; rx=&#34;2&#34; ry=&#34;2&#34;/&gt;&#xD;&#xA;                &lt;line x1=&#34;16&#34; x2=&#34;16&#34; y1=&#34;2&#34; y2=&#34;6&#34;/&gt;&#xD;&#xA;                &lt;line x1=&#34;8&#34; x2=&#34;8&#34; y1=&#34;2&#34; y2=&#34;6&#34;/&gt;&#xD;&#xA;                &lt;line x1=&#34;3&#34; x2=&#34;21&#34; y1=&#34;10&#34; y2=&#34;10&#34;/&gt;&#xD;&#xA;            &lt;/svg&gt;&#xD;&#xA;            &lt;span&gt;Chọn ngày Dương Lịch:&lt;/span&gt;&#xD;&#xA;        &lt;/label&gt;&#xD;&#xA;        &lt;input type=&#34;date&#34; id=&#34;am-lich-input&#34; name=&#34;am-lich&#34; class=&#34;amlich-input&#34;&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;amlich-result-card&#34;&gt;&#xD;&#xA;        &lt;div class=&#34;amlich-primary-banner&#34;&gt;&#xD;&#xA;            &lt;div class=&#34;amlich-badge&#34;&gt;Âm Lịch&lt;/div&gt;&#xD;&#xA;            &lt;div id=&#34;am-lich-result&#34; class=&#34;amlich-main-date&#34;&gt;Đang tải...&lt;/div&gt;&#xD;&#xA;            &lt;div id=&#34;am-lich-thu&#34; class=&#34;amlich-weekday&#34;&gt;...&lt;/div&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;        &lt;div class=&#34;amlich-canchi-grid&#34;&gt;&#xD;&#xA;            &lt;div class=&#34;amlich-canchi-card&#34;&gt;&#xD;&#xA;                &lt;span class=&#34;amlich-canchi-label&#34;&gt;Ngày&lt;/span&gt;&#xD;&#xA;                &lt;span id=&#34;am-lich-ngay&#34; class=&#34;amlich-canchi-value&#34;&gt;...&lt;/span&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;            &lt;div class=&#34;amlich-canchi-card&#34;&gt;&#xD;&#xA;                &lt;span class=&#34;amlich-canchi-label&#34;&gt;Tháng&lt;/span&gt;&#xD;&#xA;                &lt;span id=&#34;am-lich-thang&#34; class=&#34;amlich-canchi-value&#34;&gt;...&lt;/span&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;            &lt;div class=&#34;amlich-canchi-card&#34;&gt;&#xD;&#xA;                &lt;span class=&#34;amlich-canchi-label&#34;&gt;Năm&lt;/span&gt;&#xD;&#xA;                &lt;span id=&#34;am-lich-nam&#34; class=&#34;amlich-canchi-value&#34;&gt;...&lt;/span&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;script type=&#34;module&#34; src=&#34;http://localhost:1313/js/toolbox/am-lich.js&#34;&gt;&lt;/script&gt;</description>
			</item>
			<item>
				<title>QR Code Generator</title>
				<link>http://localhost:1313/project/toolbox/qr-code-generator/</link>
				<pubDate>Sat, 18 Oct 2025 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/project/toolbox/qr-code-generator/</guid>
				<description>&lt;div class=&#34;qr-wrapper&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;qr-info-note&#34;&gt;&#xD;&#xA;        &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;16&#34; height=&#34;16&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;&#xD;&#xA;            &lt;rect width=&#34;18&#34; height=&#34;18&#34; x=&#34;3&#34; y=&#34;3&#34; rx=&#34;2&#34;/&gt;&#xD;&#xA;            &lt;path d=&#34;M7 7h.01&#34;/&gt;&#xD;&#xA;            &lt;path d=&#34;M17 7h.01&#34;/&gt;&#xD;&#xA;            &lt;path d=&#34;M7 17h.01&#34;/&gt;&#xD;&#xA;            &lt;path d=&#34;M17 17h.01&#34;/&gt;&#xD;&#xA;        &lt;/svg&gt;&#xD;&#xA;        &lt;span&gt;Completely client-side and private — no data is tracked or stored.&lt;/span&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;qr-studio-grid&#34;&gt;&#xD;&#xA;        &lt;div class=&#34;qr-card qr-input-card&#34;&gt;&#xD;&#xA;            &lt;h2 class=&#34;qr-card-title&#34;&gt;&#xD;&#xA;                &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;18&#34; height=&#34;18&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;&#xD;&#xA;                    &lt;path d=&#34;M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7&#34;/&gt;&#xD;&#xA;                    &lt;path d=&#34;M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z&#34;/&gt;&#xD;&#xA;                &lt;/svg&gt;&#xD;&#xA;                &lt;span&gt;QR Code Content&lt;/span&gt;&#xD;&#xA;            &lt;/h2&gt;&#xD;&#xA;            &lt;textarea id=&#34;qr-code-input&#34; placeholder=&#34;Enter text, phone number, or URL...&#34; autofocus&gt;&lt;/textarea&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;        &lt;div class=&#34;qr-card qr-output-card&#34;&gt;&#xD;&#xA;            &lt;h2 class=&#34;qr-card-title&#34;&gt;&#xD;&#xA;                &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;18&#34; height=&#34;18&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;&#xD;&#xA;                    &lt;path d=&#34;M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z&#34;/&gt;&#xD;&#xA;                    &lt;circle cx=&#34;12&#34; cy=&#34;12&#34; r=&#34;3&#34;/&gt;&#xD;&#xA;                &lt;/svg&gt;&#xD;&#xA;                &lt;span&gt;Preview&lt;/span&gt;&#xD;&#xA;            &lt;/h2&gt;&#xD;&#xA;&#xD;&#xA;            &lt;div class=&#34;qr-canvas-frame&#34;&gt;&#xD;&#xA;                &lt;div id=&#34;qr-code-output&#34;&gt;&lt;/div&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;            &lt;div id=&#34;qr-code-download-container&#34;&gt;&#xD;&#xA;                &lt;button id=&#34;qr-code-download&#34; class=&#34;qr-download-btn&#34;&gt;&#xD;&#xA;                    &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;17&#34; height=&#34;17&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;&#xD;&#xA;                        &lt;path d=&#34;M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4&#34;/&gt;&#xD;&#xA;                        &lt;polyline points=&#34;7 10 12 15 17 10&#34;/&gt;&#xD;&#xA;                        &lt;line x1=&#34;12&#34; x2=&#34;12&#34; y1=&#34;15&#34; y2=&#34;3&#34;/&gt;&#xD;&#xA;                    &lt;/svg&gt;&#xD;&#xA;                    &lt;span&gt;Download PNG&lt;/span&gt;&#xD;&#xA;                &lt;/button&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;script src=&#34;https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js&#34;&gt;&lt;/script&gt;&#xD;&#xA;&lt;script src=&#34;http://localhost:1313/js/toolbox/qr-code-generator.js&#34;&gt;&lt;/script&gt;</description>
			</item>
			<item>
				<title>fit@hcmus feeds</title>
