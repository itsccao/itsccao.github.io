				<pubDate>Sun, 03 Aug 2025 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/project/toolbox/hcmus-fit-feeds/</guid>
				<description>&lt;div class=&#34;fit-wrapper&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;fit-info-bar&#34;&gt;&#xD;&#xA;        &lt;div class=&#34;fit-proxy-note&#34;&gt;&#xD;&#xA;            &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;15&#34; height=&#34;15&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;&gt;&#xD;&#xA;                &lt;circle cx=&#34;12&#34; cy=&#34;12&#34; r=&#34;10&#34;&gt;&lt;/circle&gt;&#xD;&#xA;                &lt;line x1=&#34;2&#34; y1=&#34;12&#34; x2=&#34;22&#34; y2=&#34;12&#34;&gt;&lt;/line&gt;&#xD;&#xA;                &lt;path d=&#34;M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z&#34;&gt;&lt;/path&gt;&#xD;&#xA;            &lt;/svg&gt;&#xD;&#xA;            &lt;span&gt;Bypass CORS qua &lt;a href=&#34;https://allorigins.win/&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;allorigins.win&lt;/a&gt;&lt;/span&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;        &lt;button id=&#34;hcmus-fit-refresh&#34; class=&#34;fit-refresh-btn&#34; aria-label=&#34;Làm mới tin tức&#34;&gt;&#xD;&#xA;            &lt;svg xmlns=&#34;http://www.w3.org/2000/svg&#34; width=&#34;16&#34; height=&#34;16&#34; viewBox=&#34;0 0 24 24&#34; fill=&#34;none&#34;&gt;&#xD;&#xA;                &lt;path fill-rule=&#34;evenodd&#34; clip-rule=&#34;evenodd&#34; d=&#34;M18.364 3.05762C18.7782 3.05762 19.114 3.3934 19.114 3.80762V8.05026C19.114 8.46447 18.7782 8.80026 18.364 8.80026H14.1213C13.7071 8.80026 13.3713 8.46447 13.3713 8.05026C13.3713 7.63604 13.7071 7.30026 14.1213 7.30026H16.4817C13.6363 5.05718 9.4987 5.24825 6.87348 7.87348C4.04217 10.7048 4.04217 15.2952 6.87348 18.1265C9.70478 20.9578 14.2952 20.9578 17.1265 18.1265C19.0234 16.2297 19.6504 13.5428 19.0039 11.1219C18.897 10.7217 19.1348 10.3106 19.535 10.2038C19.9352 10.0969 20.3462 10.3347 20.4531 10.7349C21.2321 13.6518 20.478 16.8964 18.1872 19.1872C14.7701 22.6043 9.2299 22.6043 5.81282 19.1872C2.39573 15.7701 2.39573 10.2299 5.81282 6.81282C9.04483 3.5808 14.1762 3.40576 17.614 6.28768V3.80762C17.614 3.3934 17.9497 3.05762 18.364 3.05762Z&#34; fill=&#34;currentColor&#34;&gt;&lt;/path&gt;&#xD;&#xA;            &lt;/svg&gt;&#xD;&#xA;            &lt;span&gt;Làm mới&lt;/span&gt;&#xD;&#xA;        &lt;/button&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;fit-stats-grid&#34;&gt;&#xD;&#xA;        &lt;div class=&#34;fit-stat-card&#34;&gt;&#xD;&#xA;            &lt;span class=&#34;fit-stat-label&#34;&gt;Trạng thái&lt;/span&gt;&#xD;&#xA;            &lt;div class=&#34;fit-status-badge&#34;&gt;&#xD;&#xA;                &lt;span class=&#34;fit-status-dot&#34;&gt;&lt;/span&gt;&#xD;&#xA;                &lt;span id=&#34;hcmus-fit-status&#34; class=&#34;fit-status-text&#34;&gt;Chưa tải dữ liệu&lt;/span&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;        &lt;div class=&#34;fit-stat-card&#34;&gt;&#xD;&#xA;            &lt;span class=&#34;fit-stat-label&#34;&gt;Tin bài mới&lt;/span&gt;&#xD;&#xA;            &lt;div class=&#34;fit-count-badge&#34;&gt;&#xD;&#xA;                &lt;span id=&#34;hcmus-fit-new-post&#34;&gt;0&lt;/span&gt;&#xD;&#xA;            &lt;/div&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;fit-section-header&#34;&gt;&#xD;&#xA;        &lt;h2 class=&#34;fit-section-title&#34;&gt;Danh sách tin tức mới nhất&lt;/h2&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;&#xD;&#xA;    &lt;div class=&#34;page-list-container&#34;&gt;&lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;script src=&#34;http://localhost:1313/js/toolbox/hcmus-fit-feeds.js&#34;&gt;&lt;/script&gt;</description>
